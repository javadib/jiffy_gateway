# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real values — only this .env.example is versioned.

# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Ingestion Tokens (per-provider shared secrets, sent via X_JIFFY_TOKEN header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each provider needs its own unique secret — never reuse across providers.
X_JIFFY_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITHUB_INGEST_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITLAB_INGEST_TOKEN=
GITEA_INGEST_TOKEN=

# --- Sentry (production only) ---
# SENTRY_DSN=
