# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real values — only this .env.example is versioned.

# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Redis ---
# These URLs use 127.0.0.1 for local development (running outside Docker).
# Inside docker-compose, the Celery service overrides them to use the Docker
# DNS name "redis" — see docker-compose.yml environment section.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ingestion Tokens (per-provider shared secrets, sent via X_JIFFY_TOKEN header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each provider needs its own unique secret — never reuse across providers.
X_JIFFY_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITHUB_INGEST_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITLAB_INGEST_TOKEN=
GITEA_INGEST_TOKEN=

# --- Sentry (production only) ---
# SENTRY_DSN=

# --- Sandbox Container ---
# SANDBOX_IMAGE=jiffy-sandbox:1.0.0
# SANDBOX_MEM_LIMIT=1g
# SANDBOX_CPU_LIMIT=1
# Comma-separated list of hostnames/CIDRs the sandbox container can reach.
# Includes package registries (PyPI, npm, Go) and git provider hosts by default.
# SANDBOX_NETWORK_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org,proxy.golang.org,sum.golang.org,github.com,gitlab.com,gitea.com

# --- Docker Socket Proxy ---
# Required for the Celery worker to manage sandbox containers.
# In docker-compose this is set automatically; for local dev outside containers,
# leave unset to use the default Docker socket.
# DOCKER_HOST=tcp://docker-socket-proxy:2375



# --- AGENT CONFIG ---
SANDBOX_OPENCODE_CONFIG_PATH=E:\repo\community\jiffy\jiffy_gateway\docker\sandbox\opencode.json
