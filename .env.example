# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# For local development: keep the 127.0.0.1 defaults (services run in Docker).
# For Docker Compose app service: use docker service names (db, redis, nats).

# --- Django ---
SECRET_KEY=SDFKdsfli4cfkxcxz!@%XX$LIKNcv
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
USE_SQLITE=False



# --- Redis ---
# Used for Django cache, Celery broker/result backend, and Redis Pub/Sub fallback.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7



# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- Security (production only) ---
# SECURE_SSL_REDIRECT=false

# --- Sentry (production only) ---
# SENTRY_DSN=
